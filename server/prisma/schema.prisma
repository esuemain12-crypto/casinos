generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique @db.VarChar(64)
  email          String          @unique @db.VarChar(120)
  passwordHash   String          @db.VarChar(255)
  balance        Decimal         @default(0) @db.Decimal(18, 2)
  createdAt      DateTime        @default(now())
  sessions       Session[]
  transactions   Transaction[]
  cryptoDeposits CryptoDeposit[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(20)   // deposit | withdrawal
  method    String   @db.VarChar(64)
  amount    Decimal  @db.Decimal(18, 2)
  status    String   @default("confirmed") @db.VarChar(20) // confirmed | pending | approved | denied
  wallet    String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@index([userId])
}

model CryptoDeposit {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String    @unique @db.VarChar(100)
  privateKey  String    @db.VarChar(200)
  currency    String    @default("USDT_TRC20") @db.VarChar(20)
  amountUSD   Decimal   @db.Decimal(18, 2)
  status      String    @default("pending") @db.VarChar(20) // pending | confirmed | expired
  txHash      String?   @db.VarChar(200)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  confirmedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([address])
}
