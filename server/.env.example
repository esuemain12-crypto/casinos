# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zone51?schema=public"

# JWT (сгенерируй случайную строку: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="your_64_char_random_string_here"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
HOST=0.0.0.0
SERVER_URL="https://your-domain.com"

# NOWPayments (https://nowpayments.io → API Keys)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# Frontend URL (для CORS)
FRONTEND_URL="https://your-frontend-domain.com"

# Telegram Bot (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=""
# Свой Chat ID: запусти бота и напиши /chatid
TELEGRAM_ADMIN_CHAT_ID=""
